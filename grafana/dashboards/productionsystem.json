        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_received_total{job=\"productionsystem\",controller!=\"\",code=~\"5..\"}[1m])) or vector(0)",
          "legendFormat": "5xx/с",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_requests_received_total{job=\"productionsystem\",controller!=\"\",code=~\"4..\"}[1m])) or vector(0)",
          "legendFormat": "4xx/с",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
